@page
@model Ryadevn.Pages.DbTestModel
@using Microsoft.EntityFrameworkCore
@using Ryadevn.Data

<h1>Проверка подключения к MySQL</h1>

@{
    try
    {
        var canConnect = await Model.DbContext.Database.CanConnectAsync();
        if (canConnect)
        {
            <div style="background-color: #d4edda; color: #155724; padding: 15px; border-radius: 5px; margin: 10px 0;">
                <strong>✅ Успешное подключение к MySQL!</strong><br />
                Сервер: @Model.DbContext.Database.GetDbConnection().DataSource<br />
                База данных: @Model.DbContext.Database.GetDbConnection().Database
            </div>

            <h2>📦 Товары в базе данных:</h2>

            @if (Model.Products.Any())
            {
                <table style="border-collapse: collapse; width: 100%;">
                    <tr style="background-color: #f2f2f2;">
                        <th style="border: 1px solid #ddd; padding: 8px;">ID</th>
                        <th style="border: 1px solid #ddd; padding: 8px;">Название</th>
                        <th style="border: 1px solid #ddd; padding: 8px;">Цена</th>
                    </tr>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td style="border: 1px solid #ddd; padding: 8px;">@product.Id</td>
                            <td style="border: 1px solid #ddd; padding: 8px;">@product.Name</td>
                            <td style="border: 1px solid #ddd; padding: 8px;">@product.Price ₽</td>
                        </tr>
                    }
                </table>
            }
            else
            {
                <p>Нет товаров в базе данных.</p>
            }

            <button id="showAddProductForm" class="btn btn-primary" style="margin-top: 20px;">Добавить товар</button>

            <div id="addProductForm" style="display: none; margin-top: 20px; padding: 20px; border: 1px solid #ddd; border-radius: 5px;">
                <h3>Добавить новый товар</h3>
                <form method="post" asp-page-handler="AddProduct">
                    <div class="mb-3">
                        <label for="NewProduct_Id" class="form-label">ID:</label>
                        <input type="number" class="form-control" id="NewProduct_Id" asp-for="NewProduct.Id" />
                        <span asp-validation-for="NewProduct.Id" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label for="NewProduct_Name" class="form-label">Название:</label>
                        <input type="text" class="form-control" id="NewProduct_Name" asp-for="NewProduct.Name" />
                        <span asp-validation-for="NewProduct.Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label for="NewProduct_Price" class="form-label">Цена:</label>
                        <input type="number" step="0.01" class="form-control" id="NewProduct_Price" asp-for="NewProduct.Price" />
                        <span asp-validation-for="NewProduct.Price" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-success">Сохранить</button>
                </form>
            </div>

            <script>
                document.getElementById('showAddProductForm').addEventListener('click', function () {
                    var form = document.getElementById('addProductForm');
                    if (form.style.display === 'none') {
                        form.style.display = 'block';
                    } else {
                        form.style.display = 'none';
                    }
                });
            </script>
        }
        else
        {
            <div style="background-color: #f8d7da; color: #721c24; padding: 15px; border-radius: 5px; margin: 10px 0;">
                <strong>❌ Не удалось подключиться к MySQL</strong><br />
                Проверьте, запущен ли контейнер с MySQL.
            </div>
        }
    }
    catch (Exception ex)
    {
        <div style="background-color: #f8d7da; color: #721c24; padding: 15px; border-radius: 5px; margin: 10px 0;">
            <strong>❌ Ошибка подключения:</strong><br />
            @ex.Message
        </div>
    }
}